{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StatusContract",
  "type": "object",
  "properties": {
    "request": {
      "$ref": "#/$defs/StatusRequest"
    },
    "result": {
      "$ref": "#/$defs/InventoryStatus"
    }
  },
  "required": [
    "request",
    "result"
  ],
  "$defs": {
    "Cloud": {
      "type": "string",
      "enum": [
        "us1",
        "us2",
        "eu1"
      ]
    },
    "Diagnostic": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "pointer": {
          "type": [
            "string",
            "null"
          ]
        },
        "reference": {
          "type": [
            "string",
            "null"
          ]
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "span": {
          "anyOf": [
            {
              "$ref": "#/$defs/Span"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "code",
        "severity",
        "message"
      ]
    },
    "DiscoveryMode": {
      "type": "string",
      "enum": [
        "full",
        "quick"
      ]
    },
    "DiscoveryRun": {
      "type": "object",
      "properties": {
        "answered": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "elapsed_seconds": {
          "type": "number",
          "format": "double"
        },
        "end": {
          "type": "string"
        },
        "max_queries": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "max_seconds": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "mode": {
          "$ref": "#/$defs/DiscoveryMode",
          "default": "full"
        },
        "pack_path": {
          "type": "string"
        },
        "quick_depth": {
          "$ref": "#/$defs/QuickDepth",
          "default": "sources-and-fields"
        },
        "receipt_path": {
          "type": "string"
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "start": {
          "type": "string"
        },
        "state_path": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "value_fields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "state_path",
        "pack_path",
        "receipt_path",
        "start",
        "end",
        "source_ids",
        "value_fields",
        "max_queries",
        "max_seconds",
        "answered",
        "elapsed_seconds",
        "status"
      ]
    },
    "EnvironmentId": {
      "type": "object",
      "properties": {
        "cloud": {
          "$ref": "#/$defs/Cloud"
        },
        "tenant": {
          "type": "string"
        },
        "view": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "cloud",
        "tenant",
        "view"
      ]
    },
    "FieldObservation": {
      "type": "object",
      "properties": {
        "field": {
          "type": "string"
        },
        "positive_rows": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "field",
        "positive_rows"
      ]
    },
    "FieldStatus": {
      "type": "object",
      "properties": {
        "declared": {
          "type": "boolean"
        },
        "evidence_dates": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "field": {
          "type": "string"
        },
        "measured": {
          "type": "boolean"
        },
        "not_reobserved": {
          "type": "boolean"
        },
        "observed": {
          "type": "boolean"
        },
        "status": {
          "$ref": "#/$defs/Progress"
        },
        "values": {
          "$ref": "#/$defs/Progress"
        },
        "values_requested": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "field",
        "declared",
        "observed",
        "measured",
        "status",
        "values",
        "values_requested",
        "evidence_dates",
        "not_reobserved"
      ]
    },
    "InventoryCaptureBoundary": {
      "type": "object",
      "properties": {
        "accepted_probe_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "request_sha256": {
          "type": "string"
        },
        "run": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "run",
        "request_sha256",
        "accepted_probe_ids"
      ]
    },
    "InventoryFailure": {
      "type": "object",
      "properties": {
        "message": {
          "type": "string"
        },
        "recorded_at": {
          "type": "string"
        },
        "source_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "stage": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "stage",
        "message",
        "recorded_at"
      ]
    },
    "InventoryStatus": {
      "type": "object",
      "properties": {
        "active_pack": {
          "anyOf": [
            {
              "$ref": "#/$defs/PackReference"
            },
            {
              "type": "null"
            }
          ]
        },
        "automatic_refresh_available": {
          "type": "boolean"
        },
        "blank_canvas": {
          "type": "boolean"
        },
        "context": {
          "type": [
            "string",
            "null"
          ]
        },
        "covered_queries_usable": {
          "type": "boolean"
        },
        "discovery_mode": {
          "$ref": "#/$defs/DiscoveryMode"
        },
        "discovery_runs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DiscoveryRun"
          }
        },
        "environment": {
          "anyOf": [
            {
              "$ref": "#/$defs/EnvironmentId"
            },
            {
              "type": "null"
            }
          ]
        },
        "failures": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/InventoryFailure"
          }
        },
        "full_map_complete": {
          "type": "boolean"
        },
        "inventory_notification_count": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "message": {
          "type": "string"
        },
        "next_actions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "parser_catalog": {
          "$ref": "#/$defs/Progress"
        },
        "parser_count": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "parser_page_count": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "parser_runs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ParserRun"
          }
        },
        "parsers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ParserSummary"
          }
        },
        "pending_inventory": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PendingInventoryWork"
          }
        },
        "query_observation_count": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "query_observations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/QueryObservation"
          }
        },
        "quick_depth": {
          "$ref": "#/$defs/QuickDepth"
        },
        "quick_scope_complete": {
          "type": "boolean"
        },
        "reconciliation": {
          "$ref": "#/$defs/Progress"
        },
        "refresh_attempts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RefreshStatus"
          }
        },
        "refresh_blocked": {
          "type": "boolean"
        },
        "refresh_reminder": {
          "anyOf": [
            {
              "$ref": "#/$defs/RefreshReminderStatus"
            },
            {
              "type": "null"
            }
          ]
        },
        "refresh_settings": {
          "$ref": "#/$defs/RefreshSettings"
        },
        "schema_version": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "scouting": {
          "$ref": "#/$defs/Progress"
        },
        "scouting_evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ScoutSummary"
          }
        },
        "selected_scope_complete": {
          "type": "boolean"
        },
        "settings_attention": {
          "type": "boolean"
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourceStatus"
          }
        },
        "target": {
          "$ref": "#/$defs/Progress"
        },
        "target_scope": {
          "anyOf": [
            {
              "$ref": "#/$defs/TargetScope"
            },
            {
              "type": "null"
            }
          ]
        },
        "unclassified_parser_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unverified_lead_count": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "unverified_leads": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/UnverifiedFieldLead"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "schema_version",
        "blank_canvas",
        "full_map_complete",
        "selected_scope_complete",
        "quick_scope_complete",
        "discovery_mode",
        "quick_depth",
        "unverified_lead_count",
        "query_observation_count",
        "refresh_settings",
        "automatic_refresh_available",
        "refresh_attempts",
        "refresh_blocked",
        "pending_inventory",
        "inventory_notification_count",
        "settings_attention",
        "unverified_leads",
        "query_observations",
        "message",
        "target",
        "scouting",
        "parser_catalog",
        "reconciliation",
        "parser_count",
        "parser_page_count",
        "parsers",
        "scouting_evidence",
        "unclassified_parser_ids",
        "sources",
        "discovery_runs",
        "parser_runs",
        "failures",
        "next_actions",
        "covered_queries_usable"
      ]
    },
    "InventoryWorkRunProof": {
      "type": "object",
      "properties": {
        "fields": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "request_sha256": {
          "type": "string"
        },
        "run": {
          "type": "string"
        },
        "source_probe_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "run",
        "request_sha256",
        "fields"
      ]
    },
    "NativeSourceReason": {
      "type": "string",
      "enum": [
        "falcon-sensor-native",
        "platform-internal"
      ]
    },
    "PackReference": {
      "type": "object",
      "properties": {
        "content_digest": {
          "type": "string"
        },
        "discovery_run": {
          "type": [
            "string",
            "null"
          ]
        },
        "imported_at": {
          "type": "string"
        },
        "path": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "path",
        "content_digest",
        "imported_at"
      ]
    },
    "ParserBinding": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "evidence": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "parser"
            },
            "parser_id": {
              "type": "string"
            },
            "parser_sha256": {
              "type": "string"
            },
            "reviewed_at": {
              "type": "string"
            },
            "semantics": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/SemanticReview"
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "parser_id",
            "parser_sha256",
            "reviewed_at",
            "evidence",
            "semantics"
          ]
        },
        {
          "type": "object",
          "properties": {
            "evidence": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "not-applicable"
            },
            "reason": {
              "$ref": "#/$defs/NativeSourceReason"
            },
            "reviewed_at": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "reason",
            "reviewed_at",
            "evidence"
          ]
        }
      ]
    },
    "ParserRun": {
      "type": "object",
      "properties": {
        "elapsed_seconds": {
          "type": "number",
          "format": "double"
        },
        "failure": {
          "anyOf": [
            {
              "$ref": "#/$defs/Diagnostic"
            },
            {
              "type": "null"
            }
          ]
        },
        "max_pages": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "max_parsers": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "max_seconds": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "pages_completed": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "parsers_completed": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "started_at": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "started_at",
        "max_pages",
        "max_parsers",
        "max_seconds",
        "pages_completed",
        "parsers_completed",
        "elapsed_seconds"
      ]
    },
    "ParserSummary": {
      "type": "object",
      "properties": {
        "array_fields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "declared_fields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "fields_to_tag": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "retrieved_at": {
          "type": "string"
        },
        "review_lines": {
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint32",
            "minimum": 0
          }
        },
        "sha256": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "sha256",
        "retrieved_at",
        "declared_fields",
        "fields_to_tag",
        "array_fields",
        "review_lines"
      ]
    },
    "PendingInventoryWork": {
      "type": "object",
      "properties": {
        "after_run": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "capture_boundary": {
          "anyOf": [
            {
              "$ref": "#/$defs/InventoryCaptureBoundary"
            },
            {
              "type": "null"
            }
          ]
        },
        "deferred": {
          "type": "boolean"
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "id": {
          "type": "string"
        },
        "new_source": {
          "type": "boolean"
        },
        "notified_revision": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "resolution": {
          "anyOf": [
            {
              "$ref": "#/$defs/WorkResolution"
            },
            {
              "type": "null"
            }
          ]
        },
        "revision": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "source": {
          "$ref": "#/$defs/Scope"
        },
        "source_types": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "source",
        "fields",
        "source_types",
        "new_source",
        "revision",
        "notified_revision",
        "deferred",
        "after_run"
      ]
    },
    "Progress": {
      "type": "string",
      "enum": [
        "done",
        "pending",
        "review",
        "unknown",
        "n-a"
      ]
    },
    "QueryObservation": {
      "type": "object",
      "properties": {
        "audit_path": {
          "type": "string"
        },
        "caller_assertion": {
          "$ref": "#/$defs/QueryResultAssertion"
        },
        "end": {
          "type": "string"
        },
        "environment": {
          "$ref": "#/$defs/EnvironmentId"
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FieldObservation"
          }
        },
        "id": {
          "type": "string"
        },
        "query_sha256": {
          "type": "string"
        },
        "result_sha256": {
          "type": "string"
        },
        "retrieved_at": {
          "type": "string"
        },
        "source_id": {
          "type": "string"
        },
        "start": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "source_id",
        "environment",
        "query_sha256",
        "result_sha256",
        "audit_path",
        "start",
        "end",
        "retrieved_at",
        "caller_assertion",
        "fields"
      ]
    },
    "QueryResultAssertion": {
      "type": "string",
      "enum": [
        "exact-query-result-target-window"
      ]
    },
    "QuickDepth": {
      "type": "string",
      "enum": [
        "sources-only",
        "sources-and-fields"
      ]
    },
    "RecordKind": {
      "type": "object",
      "properties": {
        "field": {
          "type": "string"
        },
        "truncated": {
          "type": "boolean"
        },
        "values": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "field",
        "values",
        "truncated"
      ]
    },
    "RefreshLookback": {
      "type": "string",
      "enum": [
        "24h",
        "7d",
        "14d",
        "30d"
      ]
    },
    "RefreshPhase": {
      "type": "string",
      "enum": [
        "prepared",
        "dispatched",
        "unresolved",
        "settled",
        "imported"
      ]
    },
    "RefreshReminderStatus": {
      "type": "object",
      "properties": {
        "clock_skew": {
          "type": "boolean"
        },
        "cycle_sha256": {
          "type": "string"
        },
        "due": {
          "type": "boolean"
        },
        "due_at": {
          "type": "string"
        },
        "last_successful_window_end": {
          "type": [
            "string",
            "null"
          ]
        },
        "show_startup_notice": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "due",
        "show_startup_notice",
        "cycle_sha256",
        "due_at",
        "clock_skew"
      ]
    },
    "RefreshSettings": {
      "type": "object",
      "properties": {
        "automatic": {
          "type": "boolean"
        },
        "lookback": {
          "$ref": "#/$defs/RefreshLookback"
        }
      },
      "additionalProperties": false,
      "required": [
        "automatic",
        "lookback"
      ]
    },
    "RefreshStatus": {
      "type": "object",
      "properties": {
        "arguments": {
          "$ref": "#/$defs/SearchArguments"
        },
        "attempt_id": {
          "type": "string"
        },
        "automatic": {
          "type": "boolean"
        },
        "dispatched_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "environment": {
          "$ref": "#/$defs/EnvironmentId"
        },
        "host_evidence_sha256": {
          "type": "string"
        },
        "max_search_seconds": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "phase": {
          "$ref": "#/$defs/RefreshPhase"
        },
        "prepared_at": {
          "type": "string"
        },
        "result_sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "session_id": {
          "type": "string"
        },
        "settlement_sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "termination": {
          "anyOf": [
            {
              "$ref": "#/$defs/RefreshTermination"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "attempt_id",
        "session_id",
        "environment",
        "arguments",
        "phase",
        "automatic",
        "prepared_at",
        "max_search_seconds",
        "host_evidence_sha256"
      ]
    },
    "RefreshTermination": {
      "type": "string",
      "enum": [
        "completed",
        "cancelled",
        "timed-out",
        "not-started",
        "lifetime-expired",
        "unresolved"
      ]
    },
    "Scope": {
      "type": "object",
      "properties": {
        "event": {
          "type": [
            "string",
            "null"
          ]
        },
        "repo": {
          "type": [
            "string",
            "null"
          ]
        },
        "type": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "ScoutPlan": {
      "type": "object",
      "properties": {
        "arguments": {
          "$ref": "#/$defs/SearchArguments"
        },
        "environment": {
          "$ref": "#/$defs/EnvironmentId"
        },
        "max_seconds": {
          "type": [
            "integer",
            "null"
