{
  "source": {},
  "filters": [],
  "steps": [
    {
      "op": "call",
      "function": "correlate",
      "args": [
        {
          "value": {
            "kind": "named-query",
            "name": "BrotliFetch",
            "include": {
              "mode": "fields",
              "fields": [
                "host.name",
                "destination.domain",
                "destination.ip",
                "http.response.body.bytes"
              ]
            },
            "plan": {
              "source": {
                "repo": "egress-proxy"
              },
              "filters": [
                {
                  "op": "eq",
                  "field": "http.response.headers.content_encoding",
                  "value": "br"
                },
                {
                  "op": "call",
                  "function": "cidr",
                  "negate": true,
                  "args": [
                    {
                      "name": "field",
                      "value": {
                        "kind": "field",
                        "name": "destination.ip"
                      }
                    },
                    {
                      "name": "subnet",
                      "value": {
                        "kind": "array",
                        "items": [
                          {
                            "kind": "literal",
                            "value": "10.0.0.0/8"
                          },
                          {
                            "kind": "literal",
                            "value": "172.16.0.0/12"
                          },
                          {
                            "kind": "literal",
                            "value": "192.168.0.0/16"
                          }
                        ]
                      }
                    }
                  ]
                },
                {
                  "op": "exists",
                  "field": "host.name",
                  "present": true
                }
              ],
              "steps": []
            }
          }
        },
        {
          "value": {
            "kind": "named-query",
            "name": "Shell",
            "include": {
              "mode": "fields",
              "fields": [
                "process.parent.name",
                "process.name",
                "process.command_line"
              ]
            },
            "plan": {
              "source": {
                "repo": "endpoints-prod",
                "type": "auditd"
              },
              "filters": [
                {
                  "op": "call",
                  "function": "in",
                  "args": [
                    {
                      "name": "field",
                      "value": {
                        "kind": "field",
                        "name": "process.parent.name"
                      }
                    },
                    {
                      "name": "ignoreCase",
                      "value": {
                        "kind": "literal",
                        "value": true
                      }
                    },
                    {
                      "name": "values",
                      "value": {
                        "kind": "array",
                        "items": [
                          {
                            "kind": "literal",
                            "value": "node"
                          },
                          {
                            "kind": "literal",
                            "value": "bun"
                          },
                          {
                            "kind": "literal",
                            "value": "python3"
                          }
                        ]
                      }
                    }
                  ]
                },
                {
                  "op": "call",
                  "function": "in",
                  "args": [
                    {
                      "name": "field",
                      "value": {
                        "kind": "field",
                        "name": "process.name"
                      }
                    },
                    {
                      "name": "ignoreCase",
                      "value": {
                        "kind": "literal",
                        "value": true
                      }
                    },
                    {
                      "name": "values",
                      "value": {
                        "kind": "array",
                        "items": [
                          {
                            "kind": "literal",
                            "value": "sh"
                          },
                          {
                            "kind": "literal",
                            "value": "bash"
                          },
                          {
                            "kind": "literal",
                            "value": "dash"
                          }
                        ]
                      }
                    }
                  ]
                }
              ],
              "steps": [
                {
                  "op": "link",
                  "field": "host.name",
                  "to": "BrotliFetch",
                  "key": "host.name"
                }
              ]
            }
          }
        },
        {
          "value": {
            "kind": "named-query",
            "name": "SecretAccess",
            "include": {
              "mode": "fields",
              "fields": [
                "file.path"
              ]
            },
            "plan": {
              "source": {
                "repo": "endpoints-prod",
                "type": "auditd"
              },
              "filters": [
                {
                  "op": "regex",
                  "field": "file.path",
                  "pattern": "\\.env$|\\.aws/credentials|/etc/shadow",
                  "flags": "i"
                }
              ],
              "steps": [
                {
                  "op": "link",
                  "field": "host.name",
                  "to": "Shell",
                  "key": "host.name"
                }
              ]
            }
          }
        },
        {
          "name": "aggregation",
          "value": {
            "kind": "array",
            "items": [
              {
                "kind": "named-query",
                "name": "Callbacks",
                "after": {
                  "query": "Shell",
                  "offset": "+0s"
                },
                "before": {
                  "query": "Shell",
                  "offset": "+10m"
                },
                "plan": {
                  "source": {
                    "repo": "egress-proxy"
                  },
                  "filters": [
                    {
                      "op": "call",
                      "function": "cidr",
                      "negate": true,
                      "args": [
                        {
                          "name": "field",
                          "value": {
                            "kind": "field",
                            "name": "destination.ip"
                          }
                        },
                        {
                          "name": "subnet",
                          "value": {
                            "kind": "array",
                            "items": [
                              {
                                "kind": "literal",
                                "value": "10.0.0.0/8"
                              },
                              {
                                "kind": "literal",
                                "value": "172.16.0.0/12"
                              },
                              {
                                "kind": "literal",
                                "value": "192.168.0.0/16"
                              }
                            ]
                          }
                        }
                      ]
                    }
                  ],
                  "steps": [
                    {
                      "op": "link",
                      "field": "host.name",
                      "to": "BrotliFetch",
                      "key": "host.name"
                    },
                    {
                      "op": "count",
                      "as": "outbound_reqs"
                    }
                  ]
                }
              }
            ]
          }
        },
        {
          "name": "sequence",
          "value": {
            "kind": "literal",
            "value": true
          }
        },
        {
          "name": "within",
          "value": {
            "kind": "literal",
            "value": "5m"
          }
        }
      ]
    }
  ]
}
