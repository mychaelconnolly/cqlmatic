{
  "source": {},
  "filters": [],
  "steps": [
    {
      "op": "call",
      "function": "correlate",
      "args": [
        {
          "value": {
            "kind": "named-query",
            "name": "Probe",
            "include": {
              "mode": "fields",
              "fields": [
                "host.name",
                "source.ip",
                "url.path",
                "http.response.status_code"
              ]
            },
            "plan": {
              "source": {
                "repo": "web-edge"
              },
              "filters": [
                {
                  "op": "eq",
                  "field": "http.request.method",
                  "value": "POST"
                },
                {
                  "op": "call",
                  "function": "in",
                  "args": [
                    {
                      "name": "field",
                      "value": {
                        "kind": "field",
                        "name": "http.response.status_code"
                      }
                    },
                    {
                      "name": "values",
                      "value": {
                        "kind": "array",
                        "items": [
                          {
                            "kind": "literal",
                            "value": 500
                          },
                          {
                            "kind": "literal",
                            "value": 502
                          },
                          {
                            "kind": "literal",
                            "value": 503
                          }
                        ]
                      }
                    }
                  ]
                },
                {
                  "op": "regex",
                  "field": "url.path",
                  "pattern": "\\.php$|upload",
                  "flags": "i"
                }
              ],
              "steps": []
            }
          }
        },
        {
          "value": {
            "kind": "named-query",
            "name": "Fault",
            "include": {
              "mode": "fields",
              "fields": [
                "process.name",
                "message"
              ]
            },
            "plan": {
              "source": {
                "repo": "linux-syslog"
              },
              "filters": [
                {
                  "op": "regex",
                  "field": "message",
                  "pattern": "Allowed memory size|signal 11|exit code 70",
                  "flags": "i"
                }
              ],
              "steps": [
                {
                  "op": "link",
                  "field": "host.name",
                  "to": "Probe",
                  "key": "host.name"
                }
              ]
            }
          }
        },
        {
          "value": {
            "kind": "named-query",
            "name": "Shell",
            "include": {
              "mode": "fields",
              "fields": [
                "process.parent.name",
                "process.name",
                "process.command_line"
              ]
            },
            "plan": {
              "source": {
                "repo": "endpoints-prod",
                "type": "auditd"
              },
              "filters": [
                {
                  "op": "call",
                  "function": "in",
                  "args": [
                    {
                      "name": "field",
                      "value": {
                        "kind": "field",
                        "name": "process.parent.name"
                      }
                    },
                    {
                      "name": "ignoreCase",
                      "value": {
                        "kind": "literal",
                        "value": true
                      }
                    },
                    {
                      "name": "values",
                      "value": {
                        "kind": "array",
                        "items": [
                          {
                            "kind": "literal",
                            "value": "php-fpm"
                          },
                          {
                            "kind": "literal",
                            "value": "apache2"
                          },
                          {
                            "kind": "literal",
                            "value": "httpd"
                          }
                        ]
                      }
                    }
                  ]
                },
                {
                  "op": "call",
                  "function": "in",
                  "args": [
                    {
                      "name": "field",
                      "value": {
                        "kind": "field",
                        "name": "process.name"
                      }
                    },
                    {
                      "name": "ignoreCase",
                      "value": {
                        "kind": "literal",
                        "value": true
                      }
                    },
                    {
                      "name": "values",
                      "value": {
                        "kind": "array",
                        "items": [
                          {
                            "kind": "literal",
                            "value": "sh"
                          },
                          {
                            "kind": "literal",
                            "value": "bash"
                          },
                          {
                            "kind": "literal",
                            "value": "curl"
                          },
                          {
                            "kind": "literal",
                            "value": "wget"
                          }
                        ]
                      }
                    }
                  ]
                }
              ],
              "steps": [
                {
                  "op": "link",
                  "field": "host.name",
                  "to": "Probe",
                  "key": "host.name"
                }
              ]
            }
          }
        },
        {
          "name": "aggregation",
          "value": {
            "kind": "array",
            "items": [
              {
                "kind": "named-query",
                "name": "Drops",
                "after": {
                  "query": "Shell",
                  "offset": "+0s"
                },
                "before": {
                  "query": "Shell",
                  "offset": "+10m"
                },
                "plan": {
                  "source": {
                    "repo": "endpoints-prod",
                    "type": "auditd"
                  },
                  "filters": [
                    {
                      "op": "eq",
                      "field": "event.action",
                      "value": "file-write"
                    },
                    {
                      "op": "glob",
                      "field": "file.path",
                      "pattern": "/var/www/*.php"
                    }
                  ],
                  "steps": [
                    {
                      "op": "link",
                      "field": "host.name",
                      "to": "Probe",
                      "key": "host.name"
                    },
                    {
                      "op": "count",
                      "as": "php_writes"
                    }
                  ]
                }
              }
            ]
          }
        },
        {
          "name": "sequence",
          "value": {
            "kind": "literal",
            "value": true
          }
        },
        {
          "name": "within",
          "value": {
            "kind": "literal",
            "value": "10m"
          }
        }
      ]
    }
  ]
}
